# =============================================================================
# PRZYKŁADOWA KONFIGURACJA - skopiuj do backend/.env i dostosuj
#   cp backend/.env.example backend/.env
# Plik backend/.env jest w .gitignore. Zmienne środowiskowe procesu mają
# pierwszeństwo przed wartościami z tego pliku.
# W tym pliku NIE ma żadnych domyślnych haseł ani kluczy - puste wartości
# oznaczają "nieskonfigurowane" (patrz opisy poniżej).
# =============================================================================

# =============================================================================
# BAZA DANYCH
# =============================================================================
# "sqlite" (domyślnie, zero konfiguracji) albo "postgresql".
DB_ENGINE=sqlite
# Ścieżka bazy SQLite (względna wobec katalogu uruchomienia albo absolutna).
DB_PATH=data/czarna.db

# PostgreSQL (tylko gdy DB_ENGINE=postgresql). Hasło jest wymagane - brak
# wartości domyślnej. Launcher może trzymać je w backend/.postgres.env
# (LAUNCHER_DB_PASSWORD), również w .gitignore.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mapa_czarna_db

# =============================================================================
# SERWER
# =============================================================================
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
# Aktywna miejscowość (folder w data/locations/).
ACTIVE_LOCATION=Czarna

# Klucz podpisujący sesje admina. Zostaw PUSTE: przy pierwszym starcie
# backend wygeneruje losowy klucz i zapisze go POZA repozytorium:
#   Windows: %LOCALAPPDATA%\MapaCzarna\secret_key
#   Linux/macOS: ~/.config/mapa-czarna/secret_key
# Inną lokalizację pliku wskaż przez SECRET_KEY_FILE (nie może leżeć w repo).
# Możesz też ustawić własny losowy ciąg >= 32 znaki:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
# SECRET_KEY_FILE=

# Tryb produkcyjny: odmowa startu ze słabym SECRET_KEY, wymagane
# CORS_ALLOWED_ORIGINS, ciasteczko sesji z flagą Secure (HTTPS).
PRODUCTION=0

# =============================================================================
# AUTENTYKACJA ADMINISTRATORA
# =============================================================================
# Autoryzacja jest ZAWSZE włączona. Hasło ustaw poleceniem:
#   python -m backend.scripts.set_admin_password
# (zapisuje ADMIN_PASSWORD_HASH - hash Werkzeug - w tym pliku).
# Bez hasła wszystkie akcje admina są odrzucane (403) z instrukcją konfiguracji.
ADMIN_AUTH_ENABLED=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Czas życia sesji admina w sekundach (domyślnie 8 h).
ADMIN_SESSION_TTL_SECONDS=28800
# Wyłączenie autoryzacji wymaga OBU flag: ADMIN_AUTH_ENABLED=0 oraz
# ADMIN_AUTH_INSECURE_DISABLE=1 (ignorowane przy PRODUCTION=1). Tylko do
# lokalnych eksperymentów - nigdy w sieci LAN.
# ADMIN_AUTH_INSECURE_DISABLE=0

# =============================================================================
# OCHRONA HTTP
# =============================================================================
# Limit nieudanych logowań z jednego IP w oknie czasowym (potem 429).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# Maksymalny rozmiar ciała żądania w bajtach (domyślnie 16 MB) - większe → 413.
MAX_REQUEST_BODY_BYTES=16777216
# Dozwolone originy CORS (po przecinku). Puste = tylko ten sam origin
# (frontend jest serwowany przez backend, więc zwykle CORS nie jest potrzebny).
CORS_ALLOWED_ORIGINS=
# Flaga Secure ciasteczka sesji (domyślnie 1 przy PRODUCTION=1).
# COOKIE_SECURE=0

# =============================================================================
# DANE DEMO
# =============================================================================
# 1 = przy starcie zasil PUSTĄ bazę SQLite danymi z data/locations/<ACTIVE_LOCATION>/.
# Alternatywnie jednorazowo: python -m backend.scripts.seed_demo
SEED_DEMO_DATA=0

# =============================================================================
# PORTY EDYTORÓW POMOCNICZYCH (launcher)
# =============================================================================
GENEALOGY_EDITOR_PORT=5001
PARCEL_EDITOR_PORT=5003
